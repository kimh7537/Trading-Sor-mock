# 토스증권 Open API 설정 (Phase 8 실시세 모드)
# 이 파일을 .env로 복사하고 값을 채운다. .env는 .gitignore에 있다.
#
# 발급: https://developers.tossinvest.com — WTS > 설정 > Open API
# 주의 1. 모의투자 샌드박스가 없다. 같은 키로 실주문이 나간다.
#         이 프로젝트는 읽기(시세) 경로만 호출한다 — 주문 API를 부르지 않는다.
# 주의 2. 허용 IP를 등록해야 한다. 미등록 IP는 403.
# 주의 3. client 당 유효한 access token은 1개다. 재발급하면 이전 토큰이 즉시 무효가 된다.

# 뜨자마자 실시세에 붙는다. false면 화면의 시세 모드 토글도 잠긴다
# (키만 있으면 꺼져 있어도 종목 검색·전환은 된다 — 그 종목의 가격대를 물어야 하기 때문이다)
TOSS_ENABLED=true

TOSS_BASE_URL=https://openapi.tossinvest.com
TOSS_WS_URL=wss://openapi-ws.tossinvest.com/ws/v1
TOSS_CLIENT_ID=tsck_live_xxxxxxxxxxxxxxxxxxxxxx
TOSS_CLIENT_SECRET=tssk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 계좌 식별 키(accountSeq). 시세만 쓰면 비워 둔다
TOSS_ACCOUNT_SEQ=
